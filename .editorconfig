# EditorConfig：与 .gitattributes 保持一致（UTF-8、LF、末尾空行）
# 文档：https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.swift]
indent_style = space
indent_size = 4

[*.go]
indent_style = tab
indent_size = 4

[*.{js,json,yml,yaml,md,sh}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{Makefile,Makefile.*,*.mk}]
indent_style = tab
